# Copy to /opt/fintank/.env on the server and fill in the blanks. Never commit .env.

# Hostnames (Caddy)
SITE_HOST=www.thefintank.com
APEX_HOST=thefintank.com
API_HOST=api.thefintank.com
CADDY_GLOBAL_OPTS=

# Django
DEBUG=False
SECRET_KEY=
ALLOWED_HOSTS=api.thefintank.com,localhost
CORS_ALLOWED_ORIGINS=https://www.thefintank.com
CSRF_TRUSTED_ORIGINS=https://www.thefintank.com
FRONTEND_URL=https://www.thefintank.com
SECURE_HSTS_SECONDS=0
BACKTEST_MAX_WORKERS=2

# Redis / Celery
CACHE_REDIS_URL=redis://redis:6379/15
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Postgres (the db container takes its password from DATABASE_PASSWORD too)
DATABASE_NAME=fintank_api
DATABASE_USER=fintank
DATABASE_PASSWORD=
DATABASE_HOST=db
DATABASE_PORT=5432
DATABASE_SSLMODE=

# AWS / S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET_NAME=
AWS_REGION=us-east-1
MEDIA_S3_LOCATION=media

# Market data and news
FMP_API=
FMP_URL=
FMP_CLOUD_DATA_BASE_URL=
AZURE_BING_KEY=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_SECRET_API=
CLOUDINARY_URL=

# Nightly DB backup (deploy/backup_db.sh)
BACKUP_BUCKET=
ALERT_TOPIC_ARN=
