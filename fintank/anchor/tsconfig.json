{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node", "mocha", "jest"],
    "typeRoots": ["../node_modules/@types"],
    "lib": ["es2015"],
    "target": "es6",
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true
  },
  "include": ["tests/**/*.ts"],
  "exclude": ["node_modules", "target", "dist"]
}
